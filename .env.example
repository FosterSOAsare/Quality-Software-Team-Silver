# Copy this file to .env and change values if needed.
# Every value is optional: the defaults point at the live site.

BASE_URL=https://amethyst-sd.vercel.app
API_BASE_URL=https://amethyst-backend.vercel.app/api
BROWSER=chromium
HEADLESS=true
TIMEOUT=15s
CAPTURE_EVIDENCE=false

# Required only for admin tests (event form). Never commit the real value.
ADMIN_PASSCODE=
